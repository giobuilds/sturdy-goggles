# Copy to .env (gitignored) or export in the shell. Never commit real values.
FITLOG_DATA=./data
FITLOG_LISTEN=:8080
# IANA zone for week boundaries, e.g. Europe/London (default: system)
FITLOG_TZ=
FITLOG_MOVING_SPEED_MPS=0.5
FITLOG_ASCENT_THRESHOLD_M=3
# Stage 8 (Coach). Leave empty to run without a Coach.
FITLOG_ANTHROPIC_API_KEY=
